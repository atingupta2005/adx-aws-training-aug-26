// Module 06 — explore Filebeat web/server logs in ADX
// Database: ADXTrainingDB_<your-login>

WebServerLogs | count
WebServerLogs | getschema

WebServerLogs
| summarize Events = count() by ServerType
| order by Events desc

WebServerLogs
| where ServerType == "Linux"
| take 10
| project LogTime, Hostname, Process, Message

WebServerLogs
| where ServerType in ("Apache", "NGINX") and StatusCode > 0
| take 20
| project LogTime, ServerType, ClientIP, Request, StatusCode

WebServerLogs
| where StatusCode > 0
| summarize Hits = count() by StatusCode, ServerType
| order by StatusCode asc

WebServerLogs
| where StatusCode >= 400 and StatusCode > 0
| take 20

WebServerLogs
| summarize Events = count() by bin(LogTime, 5m), ServerType
| render timechart

.show ingestion failures
| where Table == "WebServerLogs"
| take 10
