// Module 03 — explore CloudWatch envelope data in ADX
// Database: ADXTrainingDB_<your-login>
// Run ONE statement at a time.
// Prerequisite: CloudWatchLogs populated (lab Steps 3–4).

// =============================================================================
// A. Sanity
// =============================================================================

CloudWatchLogs | count

CloudWatchLogs
| summarize Events = count() by messageType
| order by Events desc

CloudWatchLogs | getschema

// =============================================================================
// B. Envelope fields
// =============================================================================

CloudWatchLogs
| where messageType == "DATA_MESSAGE"
| take 5

CloudWatchLogs
| where messageType == "DATA_MESSAGE"
| summarize Events = count() by logGroup, logStream
| order by Events desc

CloudWatchLogs
| where messageType == "DATA_MESSAGE"
| summarize Events = count() by bin(ingestion_time(), 5m)
| render timechart

// =============================================================================
// C. Expand logEvents
// =============================================================================

CloudWatchLogs
| where messageType == "DATA_MESSAGE"
| mv-expand e = logEvents
| project logGroup, logStream,
    EventTime = e.timestamp,
    Message = e.message,
    EventId = e.id
| order by EventTime desc
| take 50

CloudWatchLogs
| where messageType == "DATA_MESSAGE"
| mv-expand e = logEvents
| extend parsed = parse_json(tostring(e.message))
| where isnotempty(parsed)
| take 10

// App fields after using checkout API (curl) or Lambda Test invokes
CloudWatchLogs
| where messageType == "DATA_MESSAGE"
| mv-expand e = logEvents
| extend parsed = parse_json(tostring(e.message))
| where isnotempty(parsed.event)
| project
    EventTime = e.timestamp,
    Level = tostring(parsed.level),
    Event = tostring(parsed.event),
    Service = tostring(parsed.service),
    TraceId = tostring(parsed.traceId),
    LatencyMs = toint(parsed.latencyMs),
    OrderId = tostring(parsed.orderId)
| order by EventTime desc
| take 50

CloudWatchLogs
| where messageType == "DATA_MESSAGE"
| mv-expand e = logEvents
| extend parsed = parse_json(tostring(e.message))
| where tostring(parsed.level) == "ERROR" or tostring(parsed.level) == "WARN"
| summarize n = count() by Event = tostring(parsed.event), Level = tostring(parsed.level)
| order by n desc

// =============================================================================
// D. Message text search
// =============================================================================

CloudWatchLogs
| where messageType == "DATA_MESSAGE"
| mv-expand e = logEvents
| where tostring(e.message) contains "account" or tostring(e.message) contains "ARN"
    or tostring(e.message) contains "order.created" or tostring(e.message) contains "ERROR"
| project EventTime = e.timestamp, Message = e.message
| take 20

// =============================================================================
// E. Ingestion health
// =============================================================================

.show ingestion failures
| where Table == "CloudWatchLogs"
| take 10
